<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 콘솔 출력 패턴 -->
    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{20}) - %msg%n"/>
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ========== 콘솔 출력 ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========== 서버 로그 (API, SyncML 처리) ========== -->
    <appender name="SERVER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/server.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/server.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========== 시뮬레이터 로그 (단말 동작) ========== -->
    <appender name="SIMULATOR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/simulator.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/simulator.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========== SyncML 메시지 로그 (XML 상세) ========== -->
    <appender name="SYNCML_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/syncml.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/syncml.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- ========== 로거 설정 ========== -->

    <!-- 시뮬레이터 패키지 → simulator.log -->
    <logger name="com.syncml.server.simulator" level="INFO" additivity="false">
        <appender-ref ref="SIMULATOR_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- SyncML 처리 패키지 → syncml.log + server.log -->
    <logger name="com.syncml.server.syncml" level="DEBUG" additivity="false">
        <appender-ref ref="SYNCML_FILE"/>
        <appender-ref ref="SERVER_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 나머지 서버 로직 → server.log -->
    <logger name="com.syncml.server" level="INFO" additivity="false">
        <appender-ref ref="SERVER_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Spring/Hibernate 로그 최소화 -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <!-- 루트 로거 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="SERVER_FILE"/>
    </root>
</configuration>

